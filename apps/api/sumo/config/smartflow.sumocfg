<configuration>
    <input>
        <net-file value="../network/smartflow.net.xml"/>
        <route-files value="../routes/traffic.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="360"/>
        <step-length value="1"/>
    </time>

    <processing>
        <time-to-teleport value="60"/>
    </processing>

    <report>
        <verbose value="true"/>
        <no-step-log value="true"/>
    </report>
</configuration>
